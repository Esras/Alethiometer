{
  "name": "alethiometer",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write src scripts vite.config.ts svelte.config.js",
    "format:check": "prettier --check src scripts vite.config.ts svelte.config.js",
    "test": "vitest run",
    "agentd": "cargo build --manifest-path agentd/Cargo.toml",
    "agentd:release": "cargo build --release --manifest-path agentd/Cargo.toml",
    "devserver": "npm run agentd && cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --bin devserver",
    "build:mac": "tauri build --bundles app && node scripts/bundle-agentd.mjs",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/culori": "^4.0.1",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "@tauri-apps/api": "^2.12.0",
    "culori": "^4.0.2"
  }
}
