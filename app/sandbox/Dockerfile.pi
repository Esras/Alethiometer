FROM docker.io/library/node:22-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends fd-find ripgrep git \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd && rm -rf /var/lib/apt/lists/*
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@1.4.0
# PATCH, until earendil-works/pi#11527: each Bedrock call left a keep-alive connection open, and OpenShell allows 96.
COPY patches/pi-bedrock-no-keepalive.mjs /tmp/
RUN node /tmp/pi-bedrock-no-keepalive.mjs "$(npm root -g)/@earendil-works/pi-coding-agent" && rm /tmp/pi-bedrock-no-keepalive.mjs
RUN git clone https://github.com/zboerner-qventus/pi-acp.git /tmp/pi-acp && cd /tmp/pi-acp \
 && git checkout 04f7c639d8f775c1a5cba7cb22433cab5bda12e8 && npm ci && npm install -g "$(npm pack | tail -1)" \
 && cd / && rm -rf /tmp/pi-acp
ENV PI_CODING_AGENT_DIR=/tmp/pi
# OpenShell 0.1.7's own policy advisor guide; its supervisor can't install it here (it runs unprivileged).
COPY openshell/policy_advisor.md /usr/local/share/openshell/policy_advisor.md
RUN mkdir -p /tmp/pi && chown node:node /tmp/pi \
 && printf '%s\n' '# OpenShell Sandbox Guidance' '' 'When you see `policy_denied`, do not treat it as final if the user task still needs that request. Read `/usr/local/share/openshell/policy_advisor.md` and use `http://policy.local` to submit the narrowest policy proposal, then wait for approval before retrying.' > /tmp/pi/AGENTS.md \
 && chown node:node /tmp/pi/AGENTS.md
