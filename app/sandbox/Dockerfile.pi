FROM docker.io/library/node:22-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends fd-find ripgrep git \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd && rm -rf /var/lib/apt/lists/*
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@1.4.0
RUN git clone https://github.com/zboerner-qventus/pi-acp.git /tmp/pi-acp && cd /tmp/pi-acp \
 && git checkout a7ed1e422e39cf75da6733c219c3d880e0a4be51 && npm ci && npm install -g "$(npm pack | tail -1)" \
 && cd / && rm -rf /tmp/pi-acp
ENV PI_CODING_AGENT_DIR=/tmp/pi
